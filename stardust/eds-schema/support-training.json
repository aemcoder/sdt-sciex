   "section": "learning-hub-features",
   "items": [
    {
     "role": "body",
     "order": 0,
     "text": "Centralized"
    },
    {
     "role": "body",
     "order": 1,
     "text": "View your enrolled and completed courses, print your certificates and browse the course catalog with a single login."
    },
    {
     "role": "cta",
     "order": 2,
     "text": "Access your Learning Hub dashboard",
